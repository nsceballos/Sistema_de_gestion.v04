# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=TU_SPREADSHEET_ID_AQUI
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"tu-proyecto",...}

# ── JWT ────────────────────────────────────────────────────────────────────────
# OBLIGATORIO en producción (Vercel): sin este valor, o con este valor de ejemplo, el servidor
# no deja iniciar sesión. Generá uno largo y aleatorio, por ejemplo con: openssl rand -hex 32
# Si lo cambiás, todas las sesiones abiertas se cierran y hay que volver a iniciar sesión.
JWT_SECRET=cambiar_este_secreto_por_uno_seguro_en_produccion

# ── Registro de usuarios ───────────────────────────────────────────────────────
# La primera cuenta se puede crear libremente. Después, sólo pueden registrarse los emails
# de esta lista (separados por comas, sin importar mayúsculas). Vacío = registro cerrado.
ALLOWED_EMAILS=

# ── Recibos ────────────────────────────────────────────────────────────────────
# Opcional. Número con el que arranca la numeración de recibos mientras la hoja "Recibos" esté
# vacía (por defecto 53, o sea el N° 0053). Después, el próximo es siempre el más alto + 1.
RECEIPT_START_NUMBER=53

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
